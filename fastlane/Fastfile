    # --- Release Lanes ---

    desc "Creates and pushes a tag on GitLab"
    lane :tag_release do
        # This lane automates the process of creating and pushing a tag to the GitLab repository.
        # It extracts the version number from the unified helper function.

        # Get the version name using the unified helper function (require Gradle)
        version_tag = get_version_tag(require_gradle: true)

        # Configure Git user (if needed).
        sh("git config --global user.email \"ricardo.dasilva@paydock.com\"") # Sets the Git user email.
        sh("git config --global user.name \"Ricardo\"") # Sets the Git user name.
        # The 'sh' action is used to execute shell commands.

        # Fetch tags and skip if tag already exists
        sh("git fetch --tags --prune")
        existing_tag = sh("git tag -l #{version_tag}", log: false).strip
        if existing_tag == version_tag
            UI.message("Tag #{version_tag} already exists; skipping creation and push")
        else
            # Create and push the tag.
            sh("git tag -a #{version_tag} -m \"Release version #{version_tag}\"") # Creates an annotated Git tag.
            #   - '-a': Creates an annotated tag.
            #   - '#{version_tag}': The tag name (e.g., "1.0.0").
            #   - '-m': Specifies the tag message.

            # Use the GITLAB_TOKEN environment variable for authentication.
            git_url_with_token = "https://gitlab-ci-token:#{ENV['GITLAB_TOKEN']}@gitlab.com/paydock/bounded-contexts/mobile/mobile-sdk-android.git"
            sh("git remote set-url origin #{git_url_with_token}") # Updates the remote URL to include the token.
            #   - 'ENV['GITLAB_TOKEN']': Accesses the 'GITLAB_TOKEN' environment variable.

            # Push the tag to the remote repository.
            sh("git push origin #{version_tag}") # Pushes the tag to the remote repository.
        end
    end

    desc "Creates a release on GitLab"
    lane :create_gitlab_release do |options|
        # This lane automates the process of creating a release on GitLab.
        # It is designed to be triggered when a new tag is pushed to the 'release' branch.

        # Get the version tag using the unified helper function
        version_tag = get_version_tag(options)

        # Ensure a version tag is available; otherwise, raise an error.
        if version_tag == "unknown"
            UI.user_error!("No version tag could be determined. Ensure you pass 'version' as an option, set CI_COMMIT_TAG, or have git tags available.")
        end

        # Extract information from environment variables.
        # These variables are typically set by the CI/CD pipeline.
        tag_name = ENV["CI_COMMIT_TAG"] # The tag name from the CI/CD environment.
        project_id = ENV["CI_PROJECT_ID"] # The project ID from the CI/CD environment.
        gitlab_token = ENV["GITLAB_TOKEN"] # The GitLab API token from the CI/CD environment.
        api_endpoint = ENV["CI_API_V4_URL"] # The GitLab API endpoint from the CI/CD environment.

        # Read the changelog file to get the release notes for the specified version.
        changelog_notes = get_release_notes(version_tag)

        # Construct the release details.
        # This includes the release name and a description that includes the changelog notes.
        release_name = "Release: v#{version_tag}" # The name of the release.
        release_description = <<~RELEASE
            #{changelog_notes}

            **Full Changelog:** [View on GitLab](https://gitlab.com/paydock/bounded-contexts/mobile/mobile-sdk-android/-/commits/#{version_tag})
        RELEASE

        # Sanitize single quotes to avoid breaking single-quoted shell strings
        release_description_safe = release_description.gsub("'", "’")

        # Define the release assets.
        # These are links to external resources related to the release.
        release_assets = [
            {
                "name" => "MobileSDK Documentation", # The name of the asset.
                "url" => "https://github.com/PayDock/mobile-sdk-doc/tree/main" # The URL of the asset.
            }
        ]

        # Construct the release data payload.
        # This is the data that will be sent to the GitLab API to create the release.
        release_data = {
            "name" => release_name, # The name of the release.
            "tag_name" => version_tag, # The tag name of the release.
            "description" => release_description_safe, # The description of the release.
            "ref" => version_tag, # The reference (tag or branch) for the release.
            "assets" => { # The assets associated with the release.
                "links" => release_assets # The links to the assets.
            }
        }.to_json # Convert the data to JSON format.

        # Construct the correct API URL.
        # This is the URL that will be used to create the release via the GitLab API.
        api_url = "#{api_endpoint}/projects/#{project_id}/releases"

        # Create the release using the GitLab API. https://docs.gitlab.com/api/releases/
        # Avoid shell quoting issues by writing JSON to a temp file and using @file syntax
        require 'tempfile'
        tmp = Tempfile.new(["gitlab_release_", ".json"])
        begin
            tmp.write(release_data)
            tmp.flush
            response = sh("curl --silent --header 'Content-Type: application/json' --header 'PRIVATE-TOKEN: #{gitlab_token}' \
                --data @#{tmp.path} \
                --request POST '#{api_url}'")
        ensure
            tmp.close!
        end

        # Output the GitLab API response for debugging purposes.
        puts "📢 GitLab API Response: #{response}"

        # Indicate that the GitLab release was created successfully.
        UI.success("✅ GitLab release created successfully: #{release_name}")
    end

    desc "Creates a release on GitHub"
    lane :create_github_release do |options|
        # This lane automates the process of creating a release on GitHub.
        # It extracts the version name from the Git tag, authenticates with GitHub, and creates a new release.

        # Get the version tag using the unified helper function
        version_tag = get_version_tag(options)

        require 'octokit' # Loads the Octokit library for interacting with the GitHub API.

        # Authenticate with GitHub (assuming GITHUB_TOKEN is set in your CI/CD variables).
        # Set up Octokit client.
        client = Octokit::Client.new(access_token: ENV['GITHUB_TOKEN']) # Creates an Octokit client.

        # Get release notes from CHANGELOG.md
        release_notes = get_release_notes(version_tag)

        # Create a release on GitHub.
        repo = 'PayDock/android-mobile-sdk' # Replace with your GitHub repository
        release_name = "v#{version_tag}" # Creates the release name (e.g., "v1.0.0").
        release_body = <<~RELEASE
            #{release_notes}

            **Full Changelog:** [View on GitLab]( https://github.com/PayDock/android-mobile-sdk/commits/#{version_tag})
        RELEASE

        release = client.create_release(repo, "#{version_tag}", { # Creates the release on GitHub.
          tag_name: "#{version_tag}", # Sets the tag name.
          name: release_name, # Sets the release name.
          body: release_body, # Sets the release body.
          is_generate_release_notes: false, # Disables automatic generation of release notes.
          make_latest: 'true' # Marks the release as the latest.
        })
        # The 'client.create_release' method is used to create the release.
    end

    # Gets the version tag using multiple fallback strategies.
    #
    # This function provides a unified way to determine the version across all lanes.
    # It prioritizes current project version over existing tags to support tag creation.
    # It tries multiple sources in order of preference and handles errors gracefully.
    #
    # Priority order:
    # 1. Lane option (:version parameter)
    # 2. CI environment variable (CI_COMMIT_TAG - for release lanes)
    # 3. Gradle project version (current version - for tag creation)
    # 4. Latest git tag (existing tags - fallback for local dev)
    #
    # @param options [Hash] Lane options that may contain a :version key
    #   - :require_gradle [Boolean] if true, only accept Gradle version and fail otherwise
    # @return [String] The version tag (without 'v' prefix), or "unknown" if none found
    def get_version_tag(options = {})
        begin
            # If Gradle is strictly required (e.g., for tag creation), do that first and error if it fails
            if options[:require_gradle]
                begin
                    repo_root = File.expand_path('..', __dir__)
                    result = sh("cd #{repo_root} && ./gradlew -q :mobile-sdk:printVersionName", log: false).strip
                    version_match = result.match(/(\d+\.\d+\.\d+)/)
                    return version_match[1] if version_match
                    UI.user_error!("Failed to parse version from Gradle output: '#{result}'")
                rescue => gradle_ex
                    UI.user_error!("Could not get Gradle version: #{gradle_ex.message}")
                end
            end

            # 1. Check if version was passed as a lane option
            version_tag = options[:version]
            return version_tag.gsub(/^v/, '') if version_tag && !version_tag.empty?

            # 2. Check CI environment variable (set on release branch with tags)
            version_tag = ENV["CI_COMMIT_TAG"]
            return version_tag.gsub(/^v/, '') if version_tag && !version_tag.empty?

            # 3. Get gradle project version (current project version for new releases)
            begin
                # Use the Gradle wrapper from repo root; compute absolute path from this Fastfile
                repo_root = File.expand_path('..', __dir__)
                result = sh("cd #{repo_root} && ./gradlew -q :mobile-sdk:printVersionName", log: false).strip
                version_match = result.match(/(\d+\.\d+\.\d+)/)
                return version_match[1] if version_match
            rescue => gradle_ex
                UI.message("⚠️ Could not get gradle version: #{gradle_ex.message}")
            end

            # 4. Fallback to latest git tag (for local development scenarios)
            begin
                git_tag = sh("git describe --tags --abbrev=0", log: false).strip
                return git_tag.gsub(/^v/, '') if git_tag && !git_tag.empty?
            rescue => git_ex
                UI.message("⚠️ No git tags found: #{git_ex.message}")
            end

            # 5. Final fallback
            UI.message("⚠️ Could not determine version from any source, using 'unknown'")
            return "unknown"

        rescue => ex
            UI.message("⚠️ Error in get_version_tag: #{ex.message}")
            return "unknown"
        end
    end

    # Extracts the release notes for a specific version from the CHANGELOG.md file.
    #
    # @param version [String] The version number to extract release notes for (e.g., "2.3.0").
    # @return [String] The release notes for the specified version, or an empty string if no entry is found.
    def get_release_notes(version)
        # Read the changelog file
        changelog_path = "../CHANGELOG.md"
        changelog_content = File.read(changelog_path)
        match = changelog_content.match(/^##\s+\[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n##\s+\[|\z)/m)
        if match
          return match[1].strip
        else
          UI.message("⚠️ No changelog entry found for version #{version}.")
          return "" # Return an empty string if no changelog entry is found
        end
    end

    # Extracts the changelog content for a specific version from a given changelog content string.
    #
    # This function is a helper function that is used by `get_release_notes`.
    # It takes the entire changelog content as a string and the version to search for.
    # It then uses a regular expression to find the section of the changelog that corresponds to the given version.
    #
    # @param changelog_content [String] The entire content of the changelog file as a string.
    # @param version [String] The version number to extract changelog content for (e.g., "2.3.0").
    # @return [String] The changelog content for the specified version, or a message indicating no entry was found.
    def extract_changelog_for_version(changelog_content, version)
        match = changelog_content.match(/^##\s+\[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n##\s+\[|\z)/m)
        if match
          return match[1].strip
        else
          return "No changelog entry found for version #{version}"
        end
    end

    # --- Publish Lanes ---

    desc "Publishes the SDK to GitHub Packages"
    lane :publish_to_github do
        # This lane publishes the built SDK to GitHub Packages.
        # It uses the 'gradle' action to execute the 'publishAllPublicationsToGitHubPackagesRepository' Gradle task.
        gradle(task: ":mobile-sdk:publishAllPublicationsToGitHubPackagesRepository")
    end

end

desc "Publishes the SDK to Maven Central using JReleaser"
lane :publish_to_maven_central do
    # This lane publishes the built SDK to Maven Central using JReleaser.

    UI.message("🚀 Starting Maven Central publishing process...")

    # Pre-flight checks for debugging
    version_tag = get_version_tag()
    UI.message("📋 Publishing version: #{version_tag}")
    UI.message("🔧 Environment: #{ENV['CI'] ? 'CI' : 'Local'}")
    UI.message("🏷️ Branch: #{ENV['CI_COMMIT_REF_NAME'] || 'unknown'}")
    UI.message("📝 Commit: #{ENV['CI_COMMIT_SHA'] ? ENV['CI_COMMIT_SHA'][0..7] : 'unknown'}")

    # Validate required environment variables
    required_vars = [
        "JRELEASER_GITLAB_TOKEN",
        "JRELEASER_GPG_PUBLIC_KEY",
        "JRELEASER_GPG_SECRET_KEY",
        "JRELEASER_GPG_PASSPHRASE",
        "JRELEASER_MAVENCENTRAL_SONATYPE_USERNAME",
        "JRELEASER_MAVENCENTRAL_SONATYPE_TOKEN"
    ]

    missing_vars = []
    required_vars.each do |var_name|
        if ENV[var_name].nil? || ENV[var_name].empty?
            missing_vars << var_name
        else
            UI.success("✅ #{var_name} is configured")

            # Basic GPG key validation (avoid security scanner false positives)
            if var_name.include?("GPG") && var_name.include?("KEY")
                key_value = ENV[var_name]
                pgp_begin = "-----BEGIN PGP"
                pgp_end = "-----END PGP"

                if var_name.include?("PUBLIC_KEY")
                    if key_value.include?("#{pgp_begin} PUBLIC KEY BLOCK-----") && key_value.include?("#{pgp_end} PUBLIC KEY BLOCK-----")
                        UI.success("✅ Public key format appears valid")
                    else
                        UI.error("❌ Public key format appears invalid")
                    end
                elsif var_name.include?("SECRET_KEY")
                    if key_value.include?("#{pgp_begin} PRIVATE KEY BLOCK-----") && key_value.include?("#{pgp_end} PRIVATE KEY BLOCK-----")
                        UI.success("✅ Private key format appears valid")
                    else
                        UI.error("❌ Private key format appears invalid")
                    end
                end
            end
        end
    end

    unless missing_vars.empty?
        UI.error("❌ Missing required environment variables:")
        missing_vars.each { |var| UI.error("   - #{var}") }
        UI.user_error!("Cannot proceed without required environment variables")
    end

    UI.message("✅ All environment variables validated")

    begin
        # Step 1: Publish artifacts to staging repository
        UI.message("📦 Publishing artifacts to staging repository...")
        gradle(task: ":mobile-sdk:publishToStaging", properties: { "org.gradle.logging.level" => "info" })
        UI.success("✅ Staging repository populated successfully")

        # Step 2: Validate JReleaser configuration
        UI.message("🔍 Validating JReleaser configuration...")
        begin
            gradle(task: ":mobile-sdk:jreleaserConfig")
            UI.success("✅ JReleaser configuration is valid")
        rescue => config_ex
            UI.error("⚠️ JReleaser config validation failed: #{config_ex.message}")
            UI.message("🔄 Continuing with release process...")
        end

        # Step 3: Run JReleaser full release process
        UI.message("🔄 Running JReleaser full release process...")
        gradle(task: ":mobile-sdk:jreleaserFullRelease", properties: { "org.gradle.logging.level" => "info" })

        # Step 4: Success notification
        UI.success("✅ Maven Central release completed successfully for version #{version_tag}")
        UI.success("🔗 Check Maven Central: https://central.sonatype.com/search?q=com.paydock")
        UI.success("📊 Monitor deployment: https://central.sonatype.com/publishing/deployments")

    rescue => ex
        # Enhanced error handling with context
        UI.error("❌ Maven Central publishing failed: #{ex.message}")
        UI.message("📋 Error details:")
        UI.message("   - Version: #{version_tag}")
        UI.message("   - Stage: #{ex.message.include?('publishToStaging') ? 'Staging' : ex.message.include?('jreleaser') ? 'JReleaser' : 'Unknown'}")
        UI.message("   - JReleaser logs available in build artifacts")
        UI.message("   - Check mobile-sdk/build/jreleaser/ for detailed logs")

        # Re-raise the exception to mark the job as failed
        raise ex
    end
end
