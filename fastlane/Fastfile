# This Fastfile defines the automation lanes for building, testing, and releasing the Mobile SDK Android project.
# It uses Fastlane to interact with the Android build system, Git, and external services like GitLab and GitHub.

default_platform(:android) # Specifies that this Fastfile is for Android.

platform :android do

    # --- Linting Lanes ---

    desc "Run Detekt formatting and analysis with reporting"
    
    # Add required imports
    require 'json'
    lane :code_quality do
        # Clean previous reports
        gradle(task: "clean")
        
        # Run detekt formatting (auto-fix issues)
        gradle(task: "detektFormat")
        
        # Run detekt analysis on the entire codebase with reporting
        gradle(task: "detektAll")
        
        # Generate reports for all modules
        gradle(task: ":mobile-sdk:detekt")
        
        # Create code quality directory if it doesn't exist
        sh("mkdir -p reports/code-quality")
        
        # Copy Detekt reports to a central location for GitLab CI
        puts "📋 Collecting Detekt reports for GitLab Code Quality..."
        
        # Copy reports if they exist, otherwise create placeholder
        reports_copied = false
        
        # Try to copy detekt reports from various possible locations
        possible_reports = [
            "mobile-sdk/build/reports/detekt.sarif",
            "mobile-sdk/build/reports/detekt-all.sarif", 
            "build/reports/detekt.sarif",
            "convention-plugins/build/reports/detekt.sarif"
        ]
        
        possible_reports.each do |report_path|
            if File.exist?(report_path)
                puts "✅ Found Detekt reports at: #{report_path}"
                # Copy all detekt files from this directory
                report_dir = File.dirname(report_path)
                sh("cp #{report_dir}/detekt* reports/code-quality/ 2>/dev/null || true")
                sh("cp #{report_dir}/detekt-all* reports/code-quality/ 2>/dev/null || true")
                
                # Normalize filenames for GitLab consistency
                if File.exist?("reports/code-quality/detekt-all.sarif")
                    sh("cp reports/code-quality/detekt-all.sarif reports/code-quality/detekt.sarif")
                end
                if File.exist?("reports/code-quality/detekt-all.html")
                    sh("cp reports/code-quality/detekt-all.html reports/code-quality/detekt.html")
                end
                if File.exist?("reports/code-quality/detekt-all.xml")
                    sh("cp reports/code-quality/detekt-all.xml reports/code-quality/detekt.xml")
                end
                
                if File.exist?("reports/code-quality/detekt.sarif")
                    reports_copied = true
                    break
                end
            end
        end
        
        unless reports_copied
            puts "⚠️ Reports not found in standard locations, trying alternative approach..."
            
            # Try running detekt directly with explicit output paths as a fallback
            begin
                puts "🔄 Running Detekt with explicit output paths..."
                sh("mkdir -p reports/code-quality")
                
                # Run detekt on mobile-sdk directly with explicit output
                gradle(
                    task: ":mobile-sdk:detekt",
                    flags: "--configure-on-demand --console=plain",
                    properties: {
                        "detekt.sarif.output" => "#{Dir.pwd}/reports/code-quality/detekt.sarif",
                        "detekt.xml.output" => "#{Dir.pwd}/reports/code-quality/detekt.xml",
                        "detekt.html.output" => "#{Dir.pwd}/reports/code-quality/detekt.html"
                    }
                )
                
                reports_copied = File.exist?("reports/code-quality/detekt.sarif")
                puts reports_copied ? "✅ Alternative approach succeeded" : "❌ Alternative approach failed"
            rescue => e
                puts "⚠️ Alternative approach failed: #{e.message}"
            end
            
            # If all else fails, create minimal valid reports
            unless reports_copied
                puts "📋 Creating fallback reports for GitLab Code Quality..."
                File.write("reports/code-quality/detekt.xml", '<?xml version="1.0" encoding="UTF-8"?><checkstyle version="4.3"></checkstyle>')
                File.write("reports/code-quality/detekt.html", '<html><body><h1>No issues found</h1><p>Detekt analysis completed with no code quality issues detected.</p></body></html>')
                
                # Create minimal valid SARIF report
                minimal_sarif = {
                    "$schema" => "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                    "version" => "2.1.0",
                    "runs" => [{
                        "results" => [],
                        "tool" => {
                            "driver" => {
                                "name" => "detekt",
                                "version" => "1.23.7",
                                "informationUri" => "https://detekt.dev",
                                "rules" => []
                            }
                        }
                    }]
                }
                File.write("reports/code-quality/detekt.sarif", JSON.pretty_generate(minimal_sarif))
                puts "✅ Fallback reports created successfully"
            end
        end
        
        # Convert SARIF to GitLab Code Quality format for better integration
        if File.exist?("reports/code-quality/detekt.sarif")
            puts "🔄 Converting SARIF to GitLab Code Quality format..."
            sh("python3 ../scripts/convert_detekt_to_gitlab_cq.py reports/code-quality/detekt.sarif reports/code-quality/gl-code-quality-report.json")
        else
            puts "⚠️ No SARIF file found, creating empty GitLab Code Quality report..."
            sh("echo '[]' > reports/code-quality/gl-code-quality-report.json")
        end
        
        # Move reports to project root for GitLab CI artifact collection
        puts "📁 Moving reports to project root for GitLab CI..."
        sh("mkdir -p ../reports/code-quality")
        sh("cp -r reports/code-quality/* ../reports/code-quality/ 2>/dev/null || echo 'No reports to move'")
        
        puts "✅ Code quality analysis completed successfully!"
        puts "   📊 Reports ready for GitLab Code Quality integration"
        puts "   📁 GitLab CI location: reports/code-quality/"
        puts "   📁 Fastlane location: fastlane/reports/code-quality/"
    end

    # --- Bin File Management Lanes ---

    desc "Commit card schemes file to repository if it has changed"
    lane :commit_bin_file do
        # Check if we have the extracted file in current directory or parent directory
        bin_file_path = nil
        if File.exist?("bin_schema/card-schemes.json")
            bin_file_path = "bin_schema/card-schemes.json"
            UI.message("Found bin file in current directory: #{bin_file_path}")
        elsif File.exist?("../bin_schema/card-schemes.json")
            bin_file_path = "../bin_schema/card-schemes.json"
            UI.message("Found bin file in parent directory: #{bin_file_path}")
        else
            UI.error("Error: card-schemes.json not found in bin_schema/ directory in current or parent directory.")
            raise "Required file bin_schema/card-schemes.json not found"
        end

        # Context
        UI.message("Preparing to commit card schemes if changed (branch: #{ENV['CI_COMMIT_REF_NAME']})")

        # Determine the correct path for mobile-sdk assets
        assets_file_path = nil
        if File.exist?("mobile-sdk/src/main/assets/card_schemas.json")
            assets_file_path = "mobile-sdk/src/main/assets/card_schemas.json"
        elsif File.exist?("../mobile-sdk/src/main/assets/card_schemas.json")
            assets_file_path = "../mobile-sdk/src/main/assets/card_schemas.json"
        end

        # Check if the extracted file has changed and commit via GitLab API
        if assets_file_path && File.exist?(assets_file_path)
            # Compare files using system command and check exit status
            files_different = false
            begin
                sh("diff -q #{bin_file_path} #{assets_file_path}")
                # If we get here, diff returned 0 (files are the same)
                files_different = false
            rescue => e
                # diff returns non-zero exit code when files are different
                if e.message.include?("differ")
                    files_different = true
                else
                    # Some other error occurred
                    raise e
                end
            end
            
            if files_different
                UI.message("Card schemes file has changed, committing the update via GitLab API...")
                commit_file_via_api(file_path: bin_file_path, commit_message: "Update card schemes from AWS S3 [skip ci]")
            else
                UI.message("Card schemes file is up to date, no changes to commit")
            end
        else
            UI.message("Card schemes file not found in assets, creating it via GitLab API...")
            commit_file_via_api(file_path: bin_file_path, commit_message: "Add card schemes file from AWS S3 [skip ci]")
        end
    end

    private_lane :commit_file_via_api do |options|
        file_path = options[:file_path]
        commit_message = options[:commit_message]
        
        # Base64 encode the new file content
        new_content = sh("base64 -w 0 #{file_path}").strip

        # Check if assets file exists (in current or parent directory)
        assets_exists = File.exist?("mobile-sdk/src/main/assets/card_schemas.json") || File.exist?("../mobile-sdk/src/main/assets/card_schemas.json")
        
        if assets_exists
            # Update existing file
            UI.message("Getting current file info from GitLab API...")
            
            # Get the current file content and SHA
            file_path_encoded = "mobile-sdk%2Fsrc%2Fmain%2Fassets%2Fcard_schemas.json"
            api_url = "#{ENV['CI_API_V4_URL']}/projects/#{ENV['CI_PROJECT_ID']}/repository/files/#{file_path_encoded}?ref=#{ENV['CI_COMMIT_REF_NAME']}"

            # Make call
            gitlab_token = ENV['GITLAB_TOKEN']
            current_file_info = sh("curl -s -w '\\nHTTP_CODE:%{http_code}' --header \"PRIVATE-TOKEN: #{gitlab_token}\" '#{api_url}'").strip
            
            # Split response and HTTP code
            response_parts = current_file_info.split("\nHTTP_CODE:")
            response_body = response_parts[0]
            http_code = response_parts[1] if response_parts.length > 1
            
            UI.message("GitLab API (get file) HTTP Status: #{http_code}")
            
            # Check for authentication errors
            if http_code == "401"
                UI.error("Authentication failed. Possible issues:")
                UI.error("  1. GITLAB_TOKEN is invalid or expired")
                UI.error("  2. Token doesn't have 'api' or 'write_repository' scope")
                UI.error("  3. Token is for wrong project/group")
                raise "GitLab API authentication failed (401 Unauthorized)"
            elsif http_code == "404"
                UI.error("File not found. This might be the first time creating the file.")
                # Handle as new file creation instead
                assets_exists = false
            elsif http_code != "200"
                UI.error("GitLab API returned HTTP #{http_code}")
                raise "GitLab API error: HTTP #{http_code}"
            end
            
            # Only proceed with update logic if we still have assets_exists = true
            if assets_exists
                # Parse the response to get the SHA
                begin
                    file_data = JSON.parse(response_body)
                    # GitLab API returns 'last_commit_id' for the commit SHA, not 'content_sha'
                    current_sha = file_data['last_commit_id']
                    
                    if current_sha.nil?
                        UI.error("Error: Could not get current file commit SHA. Response: #{response_body}")
                        UI.error("Available fields: #{file_data.keys.join(', ')}")
                        raise "Failed to get file commit SHA"
                    end
                
                    UI.message("Current file SHA: #{current_sha}")
                    
                    # Commit the file update via GitLab API
                    UI.message("Updating file via GitLab API...")
                    update_url = "#{ENV['CI_API_V4_URL']}/projects/#{ENV['CI_PROJECT_ID']}/repository/files/mobile-sdk%2Fsrc%2Fmain%2Fassets%2Fcard_schemas.json"
                    
                    update_data = {
                        branch: ENV['CI_COMMIT_REF_NAME'],
                        content: new_content,
                        encoding: "base64",
                        commit_message: commit_message,
                        last_commit_id: current_sha
                    }.to_json
                    
                    update_response = sh("curl -s --request PUT --header \"PRIVATE-TOKEN: #{gitlab_token}\" --header 'Content-Type: application/json' --data '#{update_data}' '#{update_url}'").strip
                    
                    # Minimal response logging retained
                    
                    # Check if the update was successful
                    begin
                        response_data = JSON.parse(update_response)
                        if response_data['commit_id']
                            UI.success("Card schemes file updated and committed successfully via GitLab API")
                        else
                            UI.error("Error: Failed to update file. Response: #{update_response}")
                            raise "Failed to update file"
                        end
                    rescue JSON::ParserError
                        UI.error("Error: Invalid JSON response. Response: #{update_response}")
                        raise "Invalid API response"
                    end
                    
                rescue JSON::ParserError
                    UI.error("Error: Could not parse file info response. Response: #{response_body}")
                    raise "Failed to parse API response"
                end
            end
        else
            # Create new file
            UI.message("Creating file via GitLab API...")
            create_url = "#{ENV['CI_API_V4_URL']}/projects/#{ENV['CI_PROJECT_ID']}/repository/files/mobile-sdk%2Fsrc%2Fmain%2Fassets%2Fcard_schemas.json"
            
            create_data = {
                branch: ENV['CI_COMMIT_REF_NAME'],
                content: new_content,
                encoding: "base64",
                commit_message: commit_message
            }.to_json
            
            gitlab_token = ENV['GITLAB_TOKEN']
            create_response = sh("curl -s -w '\\nHTTP_CODE:%{http_code}' --request POST --header \"PRIVATE-TOKEN: #{gitlab_token}\" --header 'Content-Type: application/json' --data '#{create_data}' '#{create_url}'").strip
            
            # Split response and HTTP code for create operation
            create_parts = create_response.split("\nHTTP_CODE:")
            create_body = create_parts[0]
            create_http_code = create_parts[1] if create_parts.length > 1
            
            UI.message("Create HTTP Status Code: #{create_http_code}")
            UI.message("Create API Response: #{create_body}")
            
            # Check for authentication errors in create operation
            if create_http_code == "401"
                UI.error("Authentication failed during file creation.")
                raise "GitLab API authentication failed (401 Unauthorized)"
            elsif create_http_code != "201"
                UI.error("GitLab API returned HTTP #{create_http_code} for file creation")
                raise "GitLab API error: HTTP #{create_http_code}"
            end
            
            # Check if the creation was successful
            begin
                response_data = JSON.parse(create_body)
                if response_data['commit_id']
                    UI.success("Card schemes file created and committed successfully via GitLab API")
                else
                    UI.error("Error: Failed to create file. Response: #{create_body}")
                    raise "Failed to create file"
                end
            rescue JSON::ParserError
                UI.error("Error: Invalid JSON response. Response: #{create_body}")
                raise "Invalid API response"
            end
        end
    end

    # --- Version Lanes ---

    desc "Update the version name in GitLab CI variables"
    lane :update_version_name do
        # Get the current branch name
        current_branch = ENV["CI_COMMIT_BRANCH"] || "main"

        # Get the current version name and code from GitLab CI variables
        current_version_name = get_gitlab_ci_variable(key: "VERSION_NAME")

        # Increment the version name (patch version)
        major, minor, patch = current_version_name.split(".").map(&:to_i)
        next_version_name = "#{major}.#{minor}.#{patch + 1}"

        # Update GitLab CI variables
        update_gitlab_ci_variable(key: "VERSION_NAME", value: next_version_name)

        # Print for debugging
        puts "Current Version Name: #{current_version_name}"
        puts "Next Version Name: #{next_version_name}"

        # Update the versions on the build.gradle.kts
        update_build_gradle_version_name(version_name: next_version_name)
    end

    desc "Update the version code in GitLab CI variables"
    lane :update_version_code do
        # Get the current branch name
        current_branch = ENV["CI_COMMIT_BRANCH"] || "main"

        # Get the current version name and code from GitLab CI variables
        current_version_code = get_gitlab_ci_variable(key: "VERSION_CODE")

        # Check if the current_version_code is an integer
        if current_version_code.to_i.to_s != current_version_code
            UI.user_error!("VERSION_CODE must be an integer in GitLab CI variables.")
        end

        # Increment the version code
        next_version_code = current_version_code.to_i + 1

        # Update GitLab CI variables
        update_gitlab_ci_variable(key: "VERSION_CODE", value: next_version_code)

        # Print for debugging
        puts "Current Version Code: #{current_version_code}"
        puts "Next Version Code: #{next_version_code}"

        # Update the versions on the build.gradle.kts
        update_build_gradle_version_code(version_code: next_version_code)
    end

    # Update a CI variable in GitLab.
    #
    # @param key [String] the name of the CI variable to update
    # @param value [String, Integer] the new value for the CI variable
    def update_gitlab_ci_variable(key:, value:)
        gitlab_token = ENV["GITLAB_TOKEN"]
        unless gitlab_token
            UI.user_error!("Missing GITLAB_TOKEN environment variable")
        end

        project_id = ENV["CI_PROJECT_ID"]
        unless project_id
            UI.user_error!("Missing CI_PROJECT_ID environment variable")
        end

        api_endpoint = ENV["CI_API_V4_URL"]
        unless api_endpoint
            UI.user_error!("Missing CI_API_V4_URL environment variable")
        end

        api_url = "#{api_endpoint}/projects/#{project_id}/variables/#{key}"

        # We now use -s and --show-error to remove the extra output
        response = sh("curl -s --show-error --request PUT --header 'Content-Type: application/json' --header 'PRIVATE-TOKEN: #{gitlab_token}' \
            --data '{\"value\":\"#{value}\", \"variable_type\":\"env_var\"}' \
            '#{api_url}'")

        # check if the command was successful.
        parsed_response = JSON.parse(response)
        if parsed_response["key"] != key
            UI.user_error!("Error setting GitLab variable: #{key}")
        end
    end

    # Get a CI variable from GitLab.
    #
    # @param key [String] the name of the CI variable to get
    # @return [String] the value of the CI variable, or "" if it's not set
    def get_gitlab_ci_variable(key:)
        # Check if the variable is set
        unless ENV[key]
            UI.user_error!("Missing CI variable: #{key}")
        end

        # Return the variable value
        return ENV[key]
    end

    # Updates the version name and version code in the build.gradle.kts file.
    #
    # @param version_name [String] The new version name.
    def update_build_gradle_version_name(version_name:)
        # Construct the path to the build.gradle.kts file.
        build_gradle_path = "../sample/build.gradle.kts"

        # Read the entire file content.
        file_content = File.read(build_gradle_path)

        # Replace the version name line.
        file_content.gsub!(/versionName = ".*"/, "versionName = \"#{version_name}\"")

        # Write the modified content back to the file.
        File.write(build_gradle_path, file_content)

        puts "Updated #{build_gradle_path} with versionName: #{version_name}"
    end

    # Updates the version name and version code in the build.gradle.kts file.
    #
    # @param version_code [Integer] The new version code.
    def update_build_gradle_version_code(version_code:)
        # Construct the path to the build.gradle.kts file.
        build_gradle_path = "../sample/build.gradle.kts"

        # Read the entire file content.
        file_content = File.read(build_gradle_path)

        # Replace the version code line.
        file_content.gsub!(/versionCode = \d+/, "versionCode = #{version_code}")

        # Write the modified content back to the file.
        File.write(build_gradle_path, file_content)

        puts "Updated #{build_gradle_path} with versionCode: #{version_code}"
    end

    # --- Build Lanes ---

    desc "Builds the debug Android app for the specified flavor"
    lane :buildDebug do |options|
        flavor = options[:flavor] || "sandbox" # Default to sandbox if no flavor is provided
        versionCode = get_gitlab_ci_variable(key: "VERSION_CODE")
        update_build_gradle_version_code(version_code: versionCode)
        gradle(task: "assemble", flavor: flavor.capitalize, build_type: "Debug")
    end

    desc "Builds the release Android app for the specified flavor"
    lane :buildRelease do |options|
        flavor = options[:flavor] || "sandbox" # Default to sandbox if no flavor is provided
        versionCode = get_gitlab_ci_variable(key: "VERSION_CODE")
        update_build_gradle_version_code(version_name: versionName, version_code: versionCode)
        gradle(task: "assemble", flavor: flavor.capitalize, build_type: "Release")
    end

    # --- Test Lane ---

    desc "Runs all unit tests for specified flavor"
    lane :test do |options|
         flavor = options[:flavor] || "staging" # Default to staging if no flavor is provided
         build_type = options[:build_type] || "Debug" # Default to Debug if no build type is provided

        # Run unit tests and generate JaCoCo XML report for the library module
        unit_test_task = ":mobile-sdk:test#{build_type.capitalize}UnitTest"
        coverage_task = ":mobile-sdk:jacoco#{build_type.capitalize}UnitTestReport"
        gradle(
            task: "#{unit_test_task} #{coverage_task}",
            flags: "--console=plain --continue"
        )

        # Emit a single-line total coverage percentage for GitLab 'coverage' parsing
        coverage_xml_path = File.expand_path("../mobile-sdk/build/reports/jacoco/jacoco#{build_type.capitalize}UnitTestReport/jacoco#{build_type.capitalize}UnitTestReport.xml", __dir__)
        if File.exist?(coverage_xml_path)
          xml = File.read(coverage_xml_path)
          # Look for the report-level LINE counter (last occurrence in XML)
          line_counters = xml.scan(/<counter type=\"LINE\" missed=\"(\d+)\" covered=\"(\d+)\"/)
          if line_counters.any?
            # Use the last LINE counter which should be the total for the entire report
            missed, covered = line_counters.last.map(&:to_i)
            total = missed + covered
            if total > 0
              pct = (covered * 100) / total
              UI.message("Total: #{pct}%")
            end
          end
        end
    end

    # -- Deploy Lane --

    desc "Deploys the Build to Firebase App Distribution for the specified flavor"
    lane :deploy do |options|
        # find apk path
        flavor = options[:flavor] || "sandbox" # Default to sandbox if no flavor is provided

        output_path = "./sample/build/outputs/apk/#{flavor}/debug/"
        output_json_path = output_path + "output-metadata.json"
        build_output = load_json(json_path: output_json_path)
        elements = build_output["elements"][0]
        apk_path = output_path + elements["outputFile"]

        # Get Git information
        branch = git_branch
        commit = last_git_commit
        commit_author = commit[:author]
        commit_message = commit[:message]

        # Format release notes
        release_note_information = <<~RELEASE_NOTES
            🚀 New Build Deployed! 🚀

            📌 Branch: #{branch}
            👤 Developer: #{commit_author}

            📝 Changes:
            - #{commit_message}
        RELEASE_NOTES

        # Append any additional notes passed as options[:r]
        release_note = "#{release_note_information}\n#{options[:r]}"

        # Print the release notes for debugging
        puts "Release Notes:\n#{release_note}"

        firebase_app_distribution(
            app: ENV["APP_ID"],
            android_artifact_type: "APK",
            apk_path: apk_path,
            release_notes: "#{release_note}",
    #              firebase_cli_token: ENV["FIREBASE_TOKEN"],
            groups: "android-testers", # Group alias.
            service_credentials_file: ENV["GOOGLE_CREDENTIALS_FILE_PATH"],
            debug: true
        )
    end

    # --- Release Lanes ---

    desc "Creates and pushes a tag on GitLab"
    lane :tag_release do
        # This lane automates the process of creating and pushing a tag to the GitLab repository.
        # It extracts the version number from the unified helper function.

        # Get the version name using the unified helper function (require Gradle)
        version_tag = get_version_tag(require_gradle: true)

        # Configure Git user (if needed).
        sh("git config --global user.email \"ricardo.dasilva@paydock.com\"") # Sets the Git user email.
        sh("git config --global user.name \"Ricardo\"") # Sets the Git user name.
        # The 'sh' action is used to execute shell commands.

        # Fetch tags and skip if tag already exists
        sh("git fetch --tags --prune")
        existing_tag = sh("git tag -l #{version_tag}", log: false).strip
        if existing_tag == version_tag
            UI.message("Tag #{version_tag} already exists; skipping creation and push")
        else
            # Create and push the tag.
            sh("git tag -a #{version_tag} -m \"Release version #{version_tag}\"") # Creates an annotated Git tag.
            #   - '-a': Creates an annotated tag.
            #   - '#{version_tag}': The tag name (e.g., "1.0.0").
            #   - '-m': Specifies the tag message.

            # Use the GITLAB_TOKEN environment variable for authentication.
            git_url_with_token = "https://gitlab-ci-token:#{ENV['GITLAB_TOKEN']}@gitlab.com/paydock/bounded-contexts/mobile/mobile-sdk-android.git"
            sh("git remote set-url origin #{git_url_with_token}") # Updates the remote URL to include the token.
            #   - 'ENV['GITLAB_TOKEN']': Accesses the 'GITLAB_TOKEN' environment variable.

            # Push the tag to the remote repository.
            sh("git push origin #{version_tag}") # Pushes the tag to the remote repository.
        end
    end

    desc "Creates a release on GitLab"
    lane :create_gitlab_release do |options|
        # This lane automates the process of creating a release on GitLab.
        # It is designed to be triggered when a new tag is pushed to the 'release' branch.

        # Get the version tag using the unified helper function
        version_tag = get_version_tag(options)

        # Ensure a version tag is available; otherwise, raise an error.
        if version_tag == "unknown"
            UI.user_error!("No version tag could be determined. Ensure you pass 'version' as an option, set CI_COMMIT_TAG, or have git tags available.")
        end

        # Extract information from environment variables.
        # These variables are typically set by the CI/CD pipeline.
        tag_name = ENV["CI_COMMIT_TAG"] # The tag name from the CI/CD environment.
        project_id = ENV["CI_PROJECT_ID"] # The project ID from the CI/CD environment.
        gitlab_token = ENV["GITLAB_TOKEN"] # The GitLab API token from the CI/CD environment.
        api_endpoint = ENV["CI_API_V4_URL"] # The GitLab API endpoint from the CI/CD environment.

        # Read the changelog file to get the release notes for the specified version.
        changelog_notes = get_release_notes(version_tag)

        # Construct the release details.
        # This includes the release name and a description that includes the changelog notes.
        release_name = "Release: v#{version_tag}" # The name of the release.
        release_description = <<~RELEASE
            #{changelog_notes}

            **Full Changelog:** [View on GitLab](https://gitlab.com/paydock/bounded-contexts/mobile/mobile-sdk-android/-/commits/#{version_tag})
        RELEASE

        # Sanitize single quotes to avoid breaking single-quoted shell strings
        release_description_safe = release_description.gsub("'", "’")

        # Define the release assets.
        # These are links to external resources related to the release.
        release_assets = [
            {
                "name" => "MobileSDK Documentation", # The name of the asset.
                "url" => "https://github.com/PayDock/mobile-sdk-doc/tree/main" # The URL of the asset.
            }
        ]

        # Construct the release data payload.
        # This is the data that will be sent to the GitLab API to create the release.
        release_data = {
            "name" => release_name, # The name of the release.
            "tag_name" => version_tag, # The tag name of the release.
            "description" => release_description_safe, # The description of the release.
            "ref" => version_tag, # The reference (tag or branch) for the release.
            "assets" => { # The assets associated with the release.
                "links" => release_assets # The links to the assets.
            }
        }.to_json # Convert the data to JSON format.

        # Construct the correct API URL.
        # This is the URL that will be used to create the release via the GitLab API.
        api_url = "#{api_endpoint}/projects/#{project_id}/releases"

        # Create the release using the GitLab API. https://docs.gitlab.com/api/releases/
        # Avoid shell quoting issues by writing JSON to a temp file and using @file syntax
        require 'tempfile'
        tmp = Tempfile.new(["gitlab_release_", ".json"])
        begin
            tmp.write(release_data)
            tmp.flush
            response = sh("curl --silent --header 'Content-Type: application/json' --header 'PRIVATE-TOKEN: #{gitlab_token}' \
                --data @#{tmp.path} \
                --request POST '#{api_url}'")
        ensure
            tmp.close!
        end

        # Output the GitLab API response for debugging purposes.
        puts "📢 GitLab API Response: #{response}"

        # Indicate that the GitLab release was created successfully.
        UI.success("✅ GitLab release created successfully: #{release_name}")
    end

    desc "Creates a release on GitHub"
    lane :create_github_release do |options|
        # This lane automates the process of creating a release on GitHub.
        # It extracts the version name from the Git tag, authenticates with GitHub, and creates a new release.

        # Get the version tag using the unified helper function
        version_tag = get_version_tag(options)

        require 'octokit' # Loads the Octokit library for interacting with the GitHub API.

        # Authenticate with GitHub (assuming GITHUB_TOKEN is set in your CI/CD variables).
        # Set up Octokit client.
        client = Octokit::Client.new(access_token: ENV['GITHUB_TOKEN']) # Creates an Octokit client.

        # Get release notes from CHANGELOG.md
        release_notes = get_release_notes(version_tag)

        # Create a release on GitHub.
        repo = 'PayDock/android-mobile-sdk' # Replace with your GitHub repository
        release_name = "v#{version_tag}" # Creates the release name (e.g., "v1.0.0").
        release_body = <<~RELEASE
            #{release_notes}

            **Full Changelog:** [View on GitLab]( https://github.com/PayDock/android-mobile-sdk/commits/#{version_tag})
        RELEASE

        release = client.create_release(repo, "#{version_tag}", { # Creates the release on GitHub.
          tag_name: "#{version_tag}", # Sets the tag name.
          name: release_name, # Sets the release name.
          body: release_body, # Sets the release body.
          is_generate_release_notes: false, # Disables automatic generation of release notes.
          make_latest: 'true' # Marks the release as the latest.
        })
        # The 'client.create_release' method is used to create the release.
    end

    # Gets the version tag using multiple fallback strategies.
    #
    # This function provides a unified way to determine the version across all lanes.
    # It prioritizes current project version over existing tags to support tag creation.
    # It tries multiple sources in order of preference and handles errors gracefully.
    #
    # Priority order:
    # 1. Lane option (:version parameter)
    # 2. CI environment variable (CI_COMMIT_TAG - for release lanes)
    # 3. Gradle project version (current version - for tag creation)
    # 4. Latest git tag (existing tags - fallback for local dev)
    #
    # @param options [Hash] Lane options that may contain a :version key
    #   - :require_gradle [Boolean] if true, only accept Gradle version and fail otherwise
    # @return [String] The version tag (without 'v' prefix), or "unknown" if none found
    def get_version_tag(options = {})
        begin
            # If Gradle is strictly required (e.g., for tag creation), do that first and error if it fails
            if options[:require_gradle]
                begin
                    repo_root = File.expand_path('..', __dir__)
                    result = sh("cd #{repo_root} && ./gradlew -q :mobile-sdk:printVersionName", log: false).strip
                    version_match = result.match(/(\d+\.\d+\.\d+)/)
                    return version_match[1] if version_match
                    UI.user_error!("Failed to parse version from Gradle output: '#{result}'")
                rescue => gradle_ex
                    UI.user_error!("Could not get Gradle version: #{gradle_ex.message}")
                end
            end

            # 1. Check if version was passed as a lane option
            version_tag = options[:version]
            return version_tag.gsub(/^v/, '') if version_tag && !version_tag.empty?

            # 2. Check CI environment variable (set on release branch with tags)
            version_tag = ENV["CI_COMMIT_TAG"]
            return version_tag.gsub(/^v/, '') if version_tag && !version_tag.empty?

            # 3. Get gradle project version (current project version for new releases)
            begin
                # Use the Gradle wrapper from repo root; compute absolute path from this Fastfile
                repo_root = File.expand_path('..', __dir__)
                result = sh("cd #{repo_root} && ./gradlew -q :mobile-sdk:printVersionName", log: false).strip
                version_match = result.match(/(\d+\.\d+\.\d+)/)
                return version_match[1] if version_match
            rescue => gradle_ex
                UI.message("⚠️ Could not get gradle version: #{gradle_ex.message}")
            end

            # 4. Fallback to latest git tag (for local development scenarios)
            begin
                git_tag = sh("git describe --tags --abbrev=0", log: false).strip
                return git_tag.gsub(/^v/, '') if git_tag && !git_tag.empty?
            rescue => git_ex
                UI.message("⚠️ No git tags found: #{git_ex.message}")
            end

            # 5. Final fallback
            UI.message("⚠️ Could not determine version from any source, using 'unknown'")
            return "unknown"

        rescue => ex
            UI.message("⚠️ Error in get_version_tag: #{ex.message}")
            return "unknown"
        end
    end

    # Extracts the release notes for a specific version from the CHANGELOG.md file.
    #
    # @param version [String] The version number to extract release notes for (e.g., "2.3.0").
    # @return [String] The release notes for the specified version, or an empty string if no entry is found.
    def get_release_notes(version)
        # Read the changelog file
        changelog_path = "../CHANGELOG.md"
        changelog_content = File.read(changelog_path)
        match = changelog_content.match(/^##\s+\[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n##\s+\[|\z)/m)
        if match
          return match[1].strip
        else
          UI.message("⚠️ No changelog entry found for version #{version}.")
          return "" # Return an empty string if no changelog entry is found
        end
    end

    # Extracts the changelog content for a specific version from a given changelog content string.
    #
    # This function is a helper function that is used by `get_release_notes`.
    # It takes the entire changelog content as a string and the version to search for.
    # It then uses a regular expression to find the section of the changelog that corresponds to the given version.
    #
    # @param changelog_content [String] The entire content of the changelog file as a string.
    # @param version [String] The version number to extract changelog content for (e.g., "2.3.0").
    # @return [String] The changelog content for the specified version, or a message indicating no entry was found.
    def extract_changelog_for_version(changelog_content, version)
        match = changelog_content.match(/^##\s+\[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n##\s+\[|\z)/m)
        if match
          return match[1].strip
        else
          return "No changelog entry found for version #{version}"
        end
    end

    # --- Publish Lanes ---

    desc "Publishes the SDK to GitHub Packages"
    lane :publish_to_github do
        # This lane publishes the built SDK to GitHub Packages.
        # It uses the 'gradle' action to execute the 'publishAllPublicationsToGitHubPackagesRepository' Gradle task.
        gradle(task: ":mobile-sdk:publishAllPublicationsToGitHubPackagesRepository")
    end

end

desc "Publishes the SDK to Maven Central using JReleaser"
lane :publish_to_maven_central do
    # This lane publishes the built SDK to Maven Central using JReleaser.

    UI.message("🚀 Starting Maven Central publishing process...")

    # Pre-flight checks for debugging
    version_tag = get_version_tag()
    UI.message("📋 Publishing version: #{version_tag}")
    UI.message("🔧 Environment: #{ENV['CI'] ? 'CI' : 'Local'}")
    UI.message("🏷️ Branch: #{ENV['CI_COMMIT_REF_NAME'] || 'unknown'}")
    UI.message("📝 Commit: #{ENV['CI_COMMIT_SHA'] ? ENV['CI_COMMIT_SHA'][0..7] : 'unknown'}")

    # Validate required environment variables
    required_vars = [
        "JRELEASER_GITLAB_TOKEN",
        "JRELEASER_GPG_PUBLIC_KEY",
        "JRELEASER_GPG_SECRET_KEY",
        "JRELEASER_GPG_PASSPHRASE",
        "JRELEASER_MAVENCENTRAL_SONATYPE_USERNAME",
        "JRELEASER_MAVENCENTRAL_SONATYPE_TOKEN"
    ]

    missing_vars = []
    required_vars.each do |var_name|
        if ENV[var_name].nil? || ENV[var_name].empty?
            missing_vars << var_name
        else
            UI.success("✅ #{var_name} is configured")

            # Basic GPG key validation (avoid security scanner false positives)
            if var_name.include?("GPG") && var_name.include?("KEY")
                key_value = ENV[var_name]
                pgp_begin = "-----BEGIN PGP"
                pgp_end = "-----END PGP"

                if var_name.include?("PUBLIC_KEY")
                    if key_value.include?("#{pgp_begin} PUBLIC KEY BLOCK-----") && key_value.include?("#{pgp_end} PUBLIC KEY BLOCK-----")
                        UI.success("✅ Public key format appears valid")
                    else
                        UI.error("❌ Public key format appears invalid")
                    end
                elsif var_name.include?("SECRET_KEY")
                    if key_value.include?("#{pgp_begin} PRIVATE KEY BLOCK-----") && key_value.include?("#{pgp_end} PRIVATE KEY BLOCK-----")
                        UI.success("✅ Private key format appears valid")
                    else
                        UI.error("❌ Private key format appears invalid")
                    end
                end
            end
        end
    end

    unless missing_vars.empty?
        UI.error("❌ Missing required environment variables:")
        missing_vars.each { |var| UI.error("   - #{var}") }
        UI.user_error!("Cannot proceed without required environment variables")
    end

    UI.message("✅ All environment variables validated")

    begin
        # Step 1: Publish artifacts to staging repository
        UI.message("📦 Publishing artifacts to staging repository...")
        gradle(task: ":mobile-sdk:publishToStaging", properties: { "org.gradle.logging.level" => "info" })
        UI.success("✅ Staging repository populated successfully")

        # Step 2: Validate JReleaser configuration
        UI.message("🔍 Validating JReleaser configuration...")
        begin
            gradle(task: ":mobile-sdk:jreleaserConfig")
            UI.success("✅ JReleaser configuration is valid")
        rescue => config_ex
            UI.error("⚠️ JReleaser config validation failed: #{config_ex.message}")
            UI.message("🔄 Continuing with release process...")
        end

        # Step 3: Run JReleaser full release process
        UI.message("🔄 Running JReleaser full release process...")
        gradle(task: ":mobile-sdk:jreleaserFullRelease", properties: { "org.gradle.logging.level" => "info" })

        # Step 4: Success notification
        UI.success("✅ Maven Central release completed successfully for version #{version_tag}")
        UI.success("🔗 Check Maven Central: https://central.sonatype.com/search?q=com.paydock")
        UI.success("📊 Monitor deployment: https://central.sonatype.com/publishing/deployments")

    rescue => ex
        # Enhanced error handling with context
        UI.error("❌ Maven Central publishing failed: #{ex.message}")
        UI.message("📋 Error details:")
        UI.message("   - Version: #{version_tag}")
        UI.message("   - Stage: #{ex.message.include?('publishToStaging') ? 'Staging' : ex.message.include?('jreleaser') ? 'JReleaser' : 'Unknown'}")
        UI.message("   - JReleaser logs available in build artifacts")
        UI.message("   - Check mobile-sdk/build/jreleaser/ for detailed logs")

        # Re-raise the exception to mark the job as failed
        raise ex
    end
end
